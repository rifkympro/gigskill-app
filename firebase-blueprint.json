{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profiles for Mahasiswa, UMKM, and Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "umkm", "admin"] },
        "balance": { "type": "number" },
        "verified": { "type": "boolean" },
        "isDummy": { "type": "boolean" },
        "univ": { "type": "string" },
        "location": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "Lowongan proyek yang diposting oleh UMKM",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "umkmId": { "type": "string" },
        "umkmName": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "budget": { "type": "number" },
        "status": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "umkmId", "title", "budget", "status"]
    },
    "Service": {
      "title": "Service",
      "description": "Katalog penawaran jasa dari mahasiswa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentId", "title", "price"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Collection of all registered users"
    },
    "projects": {
      "schema": "Project",
      "description": "Collection of projects posted by UMKM"
    },
    "services": {
      "schema": "Service",
      "description": "Collection of student services"
    }
  }
}
